{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.associations": {
			"audio_output_codec.h": "c",
			"test_signal_generator.h": "c",
			"audio_conf.h": "c",
			"kernel.h": "c",
			"array": "c",
			"bitset": "c",
			"string_view": "c",
			"initializer_list": "c",
			"ranges": "c",
			"regex": "c",
			"utility": "c",
			"util.h": "c",
			"audio_stream.h": "c",
			"clock_control.h": "c",
			"string.h": "c",
			"log.h": "c",
			"shell.h": "c"
		}
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "audio_card",
				"type": "cortex-debug",
				"request": "attach",
				"executable": "${workspaceFolder}/audio_card/build/zephyr/zephyr.elf",
				"servertype": "stlink",
				"device": "STM32F446RE",
				"interface": "swd",
				"configFiles": [
				  "interface/stlink.cfg",
				  "target/stm32f4x.cfg"
				],
				"runToEntryPoint": "main",
				"cwd": "${workspaceFolder}",
				"gdbPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb"
			  }
		],
		"compounds": []
	}
}